# Plugin ownership — last matching pattern wins.
# GitHub requests reviews from these teams on PRs that touch the path.
# Teams need write access for required code-owner reviews to apply.
# Membership lives on the team, so this file stays put when someone joins or leaves.
#
# Proposed teams to create under rh-uxd (reviews will not route until they exist):
#   ai-pf-reviewers, ai-pf-a11y-reviewers, ai-uxd-reviewers

# Default for anything not matched below
*                                   @rh-uxd/ai-helpers-maintainers

# --- PatternFly plugins ---
# Sub-plugins inherit plugins/patternfly/. pf-a11y is the only separate route.
plugins/patternfly/                 @rh-uxd/ai-pf-reviewers
plugins/patternfly/pf-a11y/         @rh-uxd/ai-pf-a11y-reviewers

# --- UXD plugins ---
plugins/uxd-*/                      @rh-uxd/ai-uxd-reviewers

# Shared infrastructure
.claude-plugin/marketplace.json     @rh-uxd/ai-helpers-maintainers
.cursor-plugin/marketplace.json     @rh-uxd/ai-helpers-maintainers
scripts/                            @rh-uxd/ai-helpers-maintainers

# Governance and contributing docs
GOVERNANCE.md                       @rh-uxd/ai-helpers-maintainers
CONTRIBUTING.md                     @rh-uxd/ai-helpers-maintainers
CONTRIBUTING-SKILLS.md              @rh-uxd/ai-helpers-maintainers
.github/CODEOWNERS                  @rh-uxd/ai-helpers-maintainers

# CI/CD
.github/workflows/                  @rh-uxd/ai-helpers-maintainers
.coderabbit.yaml                    @rh-uxd/ai-helpers-maintainers

# Repo-level config
AGENTS.md                           @rh-uxd/ai-helpers-maintainers
CLAUDE.md                           @rh-uxd/ai-helpers-maintainers
.fullsend/                          @rh-uxd/ai-helpers-maintainers
.agents/                            @rh-uxd/ai-helpers-maintainers
