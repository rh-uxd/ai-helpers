{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-helpers.uxd/schemas/v1/consistency-source.schema.json",
  "title": "Frozen optional source-check analysis retained by the evaluator",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source": { "const": "uxd-consistency-check" },
    "run_id": { "type": "string", "minLength": 1 },
    "degraded": { "type": "boolean" },
    "checked_at": { "type": "string" },
    "workspace": { "type": "string", "minLength": 1 },
    "artifact": { "$ref": "shared.schema.json#/$defs/relative_path" },
    "guideline_manifest": { "$ref": "shared.schema.json#/$defs/relative_path" },
    "design_system": {
      "type": "object", "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } },
      "required": ["id", "version"], "additionalProperties": false
    },
    "guidelines_version": { "$ref": "shared.schema.json#/$defs/sha256" },
    "guideline_context": {
      "type": "object", "properties": { "sources": { "type": "array", "items": { "type": "object" } }, "documents": { "type": "array", "items": { "type": "object" } } },
      "required": ["sources", "documents"], "additionalProperties": false
    },
    "coverage": {
      "type": "object", "properties": { "evaluated_rules": { "$ref": "#/$defs/ids" }, "unevaluated_rules": { "$ref": "#/$defs/ids" } },
      "required": ["evaluated_rules", "unevaluated_rules"], "additionalProperties": false
    },
    "guideline_consistency": {
      "type": "object", "properties": { "status": { "$ref": "#/$defs/status" }, "baseline": { "$ref": "#/$defs/group" }, "workspace": { "$ref": "#/$defs/group" } },
      "required": ["status", "baseline", "workspace"], "additionalProperties": false
    },
    "internal_consistency": {
      "type": "object", "properties": {
        "status": { "enum": ["evaluated", "partially_evaluated", "insufficient_comparators"] },
        "reason": { "type": "string" },
        "comparisons": { "type": "array", "items": { "type": "object" } },
        "uncompared_targets": { "type": "array", "items": { "type": "object" } },
        "findings": { "type": "array", "items": {
          "type": "object", "properties": { "review_candidate": { "const": true }, "confidence": { "const": "low" }, "severity": { "const": "warning" }, "verdict": { "const": "FLAGGED" }, "check_method": { "const": "internal_comparison" }, "description": { "type": "string" }, "suggestion": { "type": "string" }, "peers": { "type": "array", "minItems": 1 } },
          "required": ["review_candidate", "confidence", "severity", "verdict", "check_method", "description", "suggestion", "peers"]
        } }
      }, "required": ["status", "reason", "comparisons", "findings", "uncompared_targets"], "additionalProperties": false
    },
    "inputs": { "type": "object", "properties": { "scope": { "enum": ["workspace", "changed", "committed"] }, "head": { "type": ["string", "null"] }, "base": { "type": ["string", "null"] }, "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "files": { "type": "object" }, "target_files": { "type": "array", "items": { "type": "string" } } }, "required": ["scope", "head", "base", "source_sha256", "files", "target_files"] },
    "source_mode": { "type": "object", "properties": { "ran": { "type": "boolean" }, "violations": { "type": "array", "items": { "type": "object" } } }, "required": ["ran", "violations"] },
    "visual_mode": { "type": "object", "properties": { "ran": { "type": "boolean" }, "screenshots_checked": { "type": "integer", "minimum": 0 }, "findings": { "type": "array" } }, "required": ["ran", "screenshots_checked", "findings"] },
    "summary": {
      "type": "object", "properties": { "total_guidelines_checked": { "type": "integer", "minimum": 0 }, "violations": { "type": "integer", "minimum": 0 }, "warnings": { "type": "integer", "minimum": 0 }, "passes": { "type": "integer", "minimum": 0 } },
      "required": ["total_guidelines_checked", "violations", "warnings", "passes"], "additionalProperties": false
    },
    "evaluator_publication": {
      "type": "object", "properties": { "format": { "const": "run-relative-v1" }, "source_workspace": { "type": "string", "minLength": 1 }, "source_artifact": { "type": "string" }, "source_guideline_manifest": { "type": "string" } },
      "required": ["format", "source_workspace", "source_artifact", "source_guideline_manifest"], "additionalProperties": false
    }
  },
  "required": ["schema_version", "source", "run_id", "degraded", "checked_at", "workspace", "artifact", "guideline_manifest", "design_system", "guidelines_version", "guideline_context", "coverage", "guideline_consistency", "internal_consistency", "inputs", "source_mode", "visual_mode", "summary"],
  "additionalProperties": false,
  "$defs": {
    "ids": { "type": "array", "items": { "$ref": "evaluation.schema.json#/$defs/guideline_id" }, "uniqueItems": true },
    "status": { "enum": ["evaluated", "partially_evaluated", "not_evaluated"] },
    "group": { "type": "object", "properties": { "status": { "$ref": "#/$defs/status" }, "selected_rules": { "$ref": "#/$defs/ids" }, "evaluated_rules": { "$ref": "#/$defs/ids" } }, "required": ["status", "selected_rules", "evaluated_rules"], "additionalProperties": false }
  }
}
