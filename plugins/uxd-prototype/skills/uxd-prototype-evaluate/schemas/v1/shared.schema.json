{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-helpers.uxd/schemas/v1/shared.schema.json",
  "title": "UXD Prototype Evaluation shared v1 definitions",
  "$defs": {
    "schema_url": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "artifact_type": {
      "type": "string",
      "enum": ["brief", "evaluation", "evidence", "actions", "state"]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^eval-[A-Za-z0-9][A-Za-z0-9-]*$",
      "maxLength": 160
    },
    "prototype_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9][A-Za-z0-9-]*$",
      "maxLength": 80
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
      "maxLength": 160
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 160 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "properties": {
        "$schema": { "$ref": "#/$defs/schema_url" },
        "artifact_type": { "$ref": "#/$defs/artifact_type" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/run_id" },
        "prototype_key": { "$ref": "#/$defs/prototype_key" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "producer": { "$ref": "#/$defs/producer" }
      },
      "required": ["$schema", "artifact_type", "schema_version", "run_id", "prototype_key", "created_at", "producer"]
    },
    "bounded_text": {
      "type": "string",
      "maxLength": 280,
      "pattern": "\\S"
    },
    "recommendation": {
      "type": "string",
      "maxLength": 500,
      "pattern": "\\S"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true,
      "maxItems": 24
    }
  }
}
